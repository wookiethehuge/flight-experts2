# On Vercel: see DEPLOY.md. DATABASE_URL(_UNPOOLED) and BLOB_READ_WRITE_TOKEN come from the Neon / Blob integrations,
# SERVER_URL defaults to the project's production domain. Set PAYLOAD_SECRET, SITE_URL, SEED_ADMIN_*, secrets.

# ------------------------------------------------------------------ required
# Long random string (openssl rand -hex 32). Signs admin sessions.
PAYLOAD_SECRET=

# SQLite file for local dev. Use a postgres:// URL in production (switches to @payloadcms/db-postgres).
DATABASE_URI=file:./flight-experts.db
# DATABASE_AUTH_TOKEN=          # only for remote libSQL/Turso URLs
# DB_PUSH=false                 # disable dev schema push (use migrations)

# Public URL of this CMS (admin + API). Media URLs are absolute to it and admin cookies are only accepted from it.
SERVER_URL=http://localhost:3000
# PORT=3000

# Public URL of the static Astro site (preview links, CORS).
SITE_URL=http://localhost:4321
# Extra origins allowed to call the API from a browser (comma separated), e.g. preview deploys.
CORS_ORIGINS=http://127.0.0.1:4403,http://localhost:4321
# Extra origins whose admin cookies are accepted (rarely needed).
# CSRF_ORIGINS=

# ------------------------------------------------------------------ seed (pnpm --filter cms seed)
SEED_ADMIN_EMAIL=admin@flight-experts.local
SEED_ADMIN_PASSWORD=change-me-please
# SEED_DIR=../web/src/content/seed
# SEED_ASSETS_DIR=../web/src/assets/seed

# ------------------------------------------------------------------ static site rebuilds
# Build hook of the host that builds the Astro site (Netlify/Vercel/Cloudflare Pages). POSTed on publish.
# DEPLOY_HOOK_URL=
# DEPLOY_HOOK_DEBOUNCE_MS=15000

# ------------------------------------------------------------------ leads (enquiries)
# Forward each new enquiry to a CRM / automation webhook (Zapier, Make, HubSpot workflow ...).
# CRM_WEBHOOK_URL=
# CRM_WEBHOOK_SECRET=            # adds X-Flight-Experts-Signature: sha256=<hmac of body>
# CRM_WEBHOOK_AUTH=              # sent as the Authorization header, e.g. "Bearer xyz"
# CRM_WEBHOOK_TIMEOUT_MS=8000
# CRM_WEBHOOK_ATTEMPTS=3

# Cloudflare Turnstile (set the site key in the web app as PUBLIC_TURNSTILE_SITE_KEY). When set, every public
# enquiry must carry a valid token. Test secret (always passes): 1x0000000000000000000000000000000AA
# TURNSTILE_SECRET_KEY=

# Live chat (Jivo) webhook: POST /api/jivo-webhook?secret=<this value>. Unset = the endpoint answers 503.
# JIVO_WEBHOOK_SECRET=

# ------------------------------------------------------------------ Trustpilot reviews sync
# Shared secret for POST /api/trustpilot-sync (daily review batch from the scraper). Generate with:
#   openssl rand -hex 32
# The scraper sends it as `Authorization: Bearer <secret>` (or `x-sync-secret: <secret>`). Unset = the endpoint answers 503.
# TRUSTPILOT_SYNC_SECRET=

# Rate limit for public enquiry POSTs, per IP.
# ENQUIRY_RATE_LIMIT=5
# ENQUIRY_RATE_WINDOW_MS=60000
# Number of reverse proxies in front of this server (for X-Forwarded-For).
# TRUSTED_PROXY_HOPS=1

# ------------------------------------------------------------------ email (optional)
# Enables password-reset emails and new-lead notifications.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_ADDRESS=no-reply@flight-experts.com
# SMTP_FROM_NAME=Flight Experts
# ENQUIRY_NOTIFY_TO=experts@flight-experts.com

# ------------------------------------------------------------------ media
# MEDIA_DIR=./media              # local upload folder
# BLOB_READ_WRITE_TOKEN=         # Vercel Blob: when set, uploads are stored there (required on Vercel)
