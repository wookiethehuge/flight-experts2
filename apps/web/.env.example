# Public site URL (canonical links, sitemap, Open Graph)
SITE_URL=https://www.flight-experts.com
# Payload CMS base URL. Leave empty to build from the seed content in src/content/seed.
PAYLOAD_URL=
# Where the quote / contact forms POST to (defaults to PAYLOAD_URL). Must allow CORS from SITE_URL.
PUBLIC_FORMS_ENDPOINT=
# Optional Cloudflare Turnstile site key ("verify you are human" on the contact form and the quote form contact step).
# Create a "Managed" widget in Cloudflare and set its secret as TURNSTILE_SECRET_KEY in apps/cms/.env.
# Leave empty to use honeypot + timing + rate limit only (nothing is shown).
# Cloudflare test keys: site 1x00000000000000000000AA (always passes) with secret 1x0000000000000000000000000000000AA.
PUBLIC_TURNSTILE_SITE_KEY=
