    to { transform: translate(1.5%, -5%) rotate(-0.8deg); }
  }
  /* exhaust from the engine's rear (48.5%, 86.8% of the plane box), streaming back along the fuselage line */
  .trip__trail, .trip__plume { position: absolute; left: 48.48%; top: 86.82%; }
  .trip__trail {
    width: 80%; height: max(3px, 3.2%);
