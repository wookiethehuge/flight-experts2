      <button type="button" class="trip__btn trip__btn--primary" data-modal-add>Add Ticket Protection</button>
      <button type="button" class="trip__btn trip__btn--outline" data-modal-skip>Continue Without Protection</button>
    </div>
  </dialog>
</div>

<style>
  /* hidden parts of the flow (other steps, other options' details) stay hidden whatever their display */
  .trip [hidden] { display: none !important; }

  /* ---------------------------------------------------------------- tokens for this flow (Figma Addition 1-5) */
