  .trip__sky { position: absolute; inset: 0; width: 100%; height: 100%; animation: trip-sky 26s ease-in-out infinite alternate; will-change: transform; }
  @keyframes trip-sky {
    from { transform: scale(1.14) translate(5.5%, 1%); }
    to { transform: scale(1.14) translate(-5.5%, -1%); }
  }
  /* the content column (same edges as .trip__hero-in) */
  .trip__fly { position: absolute; inset: 0 calc(max(0px, (100cqw - var(--page-max)) / 2) + var(--gutter)); }
  /* the gap between title and card: 576 wide at 1440 (Figma), smaller on narrower screens, never under the card */
  .trip__jet {
