---
/**
 * Reviews band (navy): heading, Trustpilot rating row, horizontally scrollable testimonial cards and the airline
 * logo strip. Main 1895-2830 / Mobile 2017-2794.
 * The carousel is a native scroll-snap list (touch, trackpad, keyboard: it is focusable, arrow keys scroll). The
 * previous/next buttons are an enhancement (they scroll by one card) and stay hidden until the script runs.
 * Mobile shows the airline strip as two rows cut from the same image (Mobile artboard).
 * Cards: pinned testimonials, or the newest approved 5-star reviews (incl. synced Trustpilot ones), see lib/cms.ts.
 * No "Read on Trustpilot" link per card: the design has none (the Trustpilot logo above links to the profile).
 */
import type { Media, ReviewsBlock, SiteSettings } from '../../lib/types';
import { inline } from '../../lib/inline';
import Img from '../ui/Img.astro';
import Icon from '../ui/Icon.astro';

interface Props { block: ReviewsBlock; settings: SiteSettings; page: string; index: number }
const { block, settings, index } = Astro.props;
const reviews = (block.testimonials ?? []).filter(Boolean);   // resolved in lib/cms.ts (pinned, or newest approved 5-star)
/** Cards are sized for ~400 characters (the design's reviews); longer synced reviews are cut at a word with an ellipsis. */
const BODY_MAX = 400;
const excerpt = (s?: string | null) => {
  const t = (s ?? '').trim();
  if (t.length <= BODY_MAX) return t;
  const cut = t.slice(0, BODY_MAX + 1);
  return cut.slice(0, Math.max(cut.lastIndexOf(' '), BODY_MAX * 0.8)).replace(/[\s.,;:!?…-]+$/, '') + '…';
};
const hid = `reviews-h-${index}`;
const trackId = `reviews-track-${index}`;
const stars = { url: '/seed/trustpilot-stars.webp', alt: 'Rated 5 out of 5 stars on Trustpilot' } as Media;
const tp = { url: '/seed/trustpilot-logo.webp', alt: 'Trustpilot' } as Media;
const tpUrl = settings.trustpilot?.url;
// the whole rating row (logo, stars, "Excellent | Rated 4.9/5.0") is one link (client: badge clickable everywhere)
const Rating = tpUrl ? 'a' : 'div';
const tpLabel = `Rated ${settings.trustpilot?.rating ?? '4.9/5.0'} on Trustpilot (opens in a new tab)`;
---
<section class="rv" aria-labelledby={hid}>
  <div class="container rv__head">
    <h2 class="rv__h" id={hid} set:html={inline(block.heading)} />
    <Rating class="rv__rating" {...(tpUrl ? { href: tpUrl, target: '_blank', rel: 'noopener', 'aria-label': tpLabel } : {})}>
      <span class="rv__tp"><Img media={tp} sizes="(min-width: 48rem) 162px, 98px" widths={[98, 162, 196, 324]} /></span>
      <Img media={stars} class="rv__stars" sizes="(min-width: 48rem) 163px, 105px" widths={[105, 163, 210, 326]} />
      <p class="rv__label">{block.ratingLabel}</p>
    </Rating>
  </div>

  <div class="rv__carousel" data-reviews>
    <ul class="rv__track" id={trackId} role="list" tabindex="0" aria-label="Customer reviews (scrollable)">
      {reviews.map((r, i) => (
        <li class="rv__card" data-reveal style={`--i: ${i}`}>
          <p class="rv__name">{r.name}</p>
          <Img media={{ ...stars, alt: `Rated ${r.rating} out of 5 stars` }} class="rv__cstars" sizes="98px" widths={[98, 196]} />
          <h3 class="rv__title">
            {(r.reviewUrl || tpUrl)
              ? <a class="rv__link" href={r.reviewUrl || tpUrl} target="_blank" rel="noopener" draggable="false">{r.title}<span class="sr-only"> (read on Trustpilot, opens in a new tab)</span></a>
              : r.title}
          </h3>
          {r.body && <p class="rv__body">{excerpt(r.body)}</p>}
          {(r.reviewUrl || tpUrl) && <span class="rv__more" aria-hidden="true">Read on Trustpilot <span>↗</span></span>}
        </li>
      ))}
    </ul>
    <div class="rv__fade" aria-hidden="true"></div>
    <button type="button" class="rv__nav rv__nav--prev" aria-label="Previous review" aria-controls={trackId} data-dir="-1" hidden>
      <Icon name="chevron-down" class="rv__navic" />
    </button>
    <button type="button" class="rv__nav rv__nav--next" aria-label="Next review" aria-controls={trackId} data-dir="1" hidden>
      <Icon name="chevron-down" class="rv__navic" />
    </button>
  </div>

  {block.airlines && (
    <div class="rv__air" aria-label="Partner airlines" role="img">
      {/* an endless, slow ticker of the partner airlines (client reference: travelbusinessclass.com); the strip is
          drawn four times and moved by half its length so the loop has no seam */}
      <div class="rv__air-track" aria-hidden="true">
        {[0, 1, 2, 3].map((k) => (
          <Img media={block.airlines} decorative class="rv__air-img" sizes="(min-width: 48rem) 1040px, 560px" widths={[560, 1040, 1600, 2080]} loading={k ? 'lazy' : undefined} />
        ))}
      </div>
    </div>
  )}
</section>

<script>
  // One card per click, eased over 850ms (client: slower, smoother). Snap is paused during the glide so the browser
  // doesn't fight it, then restored; a click mid-glide continues from the current target.
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const targets = new WeakMap<HTMLElement, number>();
  function glide(track: HTMLElement, dx: number) {
    const max = track.scrollWidth - track.clientWidth;
    const from = track.scrollLeft;
    const to = Math.max(0, Math.min(max, (targets.get(track) ?? from) + dx));
    targets.set(track, to);
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { track.scrollLeft = to; targets.delete(track); return; }
    const t0 = performance.now(); const dur = 850;
    track.style.scrollSnapType = 'none';
    const id = Symbol();
    (track as any)._glide = id;
    const step = (now: number) => {
      if ((track as any)._glide !== id) return;
      const t = Math.min(1, (now - t0) / dur);
      track.scrollLeft = from + (to - from) * ease(t);
      if (t < 1) requestAnimationFrame(step);
      else { track.style.scrollSnapType = ''; targets.delete(track); }
    };
    requestAnimationFrame(step);
  }
  for (const root of document.querySelectorAll<HTMLElement>('[data-reviews]')) {
    const track = root.querySelector<HTMLElement>('.rv__track');
    if (!track) continue;
    for (const btn of root.querySelectorAll<HTMLButtonElement>('.rv__nav')) {
      btn.hidden = false;
      btn.addEventListener('click', () => {
        const card = track.querySelector<HTMLElement>('.rv__card');
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        const step = card ? card.getBoundingClientRect().width + gap : track.clientWidth * 0.8;
        glide(track, step * Number(btn.dataset.dir));
      });
    }
  }
</script>

<style>
  .rv {
    --f: calc((100vw - 24.375rem) / 1050);
    --inset: calc(max(0px, (100vw - var(--page-max)) / 2) + clamp(1.5625rem, calc(1.5625rem + 95 * var(--f)), 7.5rem));   /* first card x 25 -> 120 */
    background: var(--c-navy);
    color: var(--c-sky);
    padding-block: var(--sec-y);
    overflow: hidden;
  }
  .rv :global(picture > source) { display: none; }                           /* keep <source> out of flex gaps */
  .rv__head { padding-inline-start: calc(var(--gutter) + 0.3125rem); }        /* heading x 25 on mobile */
  .rv__h {
    max-width: 19.25rem;                                                        /* 308 */
    font-family: var(--ff-serif);
    font-weight: var(--fw-regular);
    font-size: var(--fs-h2);                                                    /* 32 -> 48 */
    line-height: clamp(2.0625rem, calc(2.0625rem + 29.4 * var(--f)), 3.9rem);   /* 33 -> 62.4 */
    color: var(--c-sky);
  }
  .rv__h :global(strong) { display: block; font-weight: var(--fw-bold); }
  .rv__h :global(em) { font-style: italic; }
  a.rv__rating { color: inherit; text-decoration: none; transition: opacity var(--dur) var(--ease); }
  a.rv__rating:hover { opacity: 0.85; }
  .rv__rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.3125rem;                                                      /* logo -> stars 5 */
    margin: 1.75rem 0 0 0.3125rem;                                              /* 28; x 30 */
  }
  .rv__tp { display: flex; }
  .rv__rating :global(img) { display: block; height: auto; }
  .rv__tp :global(img) { width: 6.125rem; }                                    /* 98 */
  .rv__rating :global(.rv__stars) { width: 6.5625rem; margin-top: 0.25rem; }   /* 105 */
  .rv__label {
    flex-basis: 100%;
    margin-top: 0.6875rem;                                                      /* 11 */
    font-size: var(--fs-14);
    font-weight: var(--fw-semibold);
    color: var(--c-cream);
    white-space: pre;
  }

  /* ---------- carousel ---------- */
  .rv__carousel { position: relative; margin-top: 2.3125rem; }                 /* 37 */
  .rv__track {
    display: flex;
    gap: clamp(1rem, calc(1rem + 3 * var(--f)), 1.1875rem);                     /* 16 -> 19 */
    margin: 0;
    padding: 0 var(--gutter) 0 var(--inset);
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: none;          /* no rubber-band past the first / last card */
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--inset) var(--gutter);
    scrollbar-width: none;
  }
  .rv__track::-webkit-scrollbar { display: none; }
  .rv__track:focus-visible { outline-offset: -3px; }
  .rv__card {
    flex: 0 0 clamp(14.875rem, calc(14.875rem + 77 * var(--f)), 19.6875rem);    /* 238 -> 315 */
    min-height: clamp(23rem, calc(23.5625rem - 9 * var(--f)), 23.5625rem);      /* 377 -> 368 */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6875rem;                                                             /* 11 */
    padding: 1rem 1.125rem;                                                     /* 16 18 */
    border-radius: var(--r-7);
    background: var(--c-sky-8);
    scroll-snap-align: start;
  }
  /* each card links to its review on Trustpilot (synced reviews carry their own URL; hand-entered ones open the
     profile). The title link is stretched over the whole card. */
  .rv__card { position: relative; transition: background-color 450ms var(--motion-ease-out), translate 450ms var(--motion-ease-out); }
  .rv__link { color: inherit; text-decoration: none; -webkit-user-drag: none; }
  /* holding a finger on a card must not pick it up as a draggable link or pop the link preview (iOS) */
  .rv__card { -webkit-touch-callout: none; -webkit-user-select: none; user-select: none; }
  .rv__card :global(img) { -webkit-user-drag: none; pointer-events: none; }
  .rv__link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .rv__link:focus-visible { outline: none; }
  .rv__card:has(.rv__link:focus-visible) { outline: 2px solid var(--c-sky); outline-offset: 3px; }
  .rv__more { margin-top: auto; padding-top: 0.5rem; font-size: var(--fs-14); font-weight: var(--fw-medium); color: var(--c-sky); opacity: 0.75; transition: opacity 450ms var(--motion-ease-out); }
  .rv__more span { display: inline-block; transition: translate 450ms var(--motion-ease-out); }
  @media (hover: hover) {
    .rv__card:has(.rv__link):hover { background: color-mix(in srgb, var(--c-sky) 13%, transparent); translate: 0 -3px; }
    .rv__card:hover .rv__more { opacity: 1; }
    .rv__card:hover .rv__more span { translate: 2px -2px; }
  }
  .rv__name, .rv__title {
    font-size: clamp(1rem, calc(1rem + 4 * var(--f)), 1.25rem);                 /* 16 -> 20 */
    line-height: clamp(1.375rem, calc(1.375rem + 5 * var(--f)), 1.6875rem);     /* 22 -> 27 */
    font-weight: var(--fw-semibold);
    font-family: var(--ff-sans);
  }
  .rv__title { max-width: 15.3125rem; }                                        /* 245 */
  .rv__card :global(.rv__cstars) { display: block; width: 6.125rem; height: auto; }   /* 98 */
  .rv__body {
    font-size: clamp(0.875rem, calc(0.875rem + 2 * var(--f)), 1rem);             /* 14 -> 16 */
    line-height: clamp(1.125rem, calc(1.125rem + 2 * var(--f)), 1.25rem);        /* 18 -> 20 (Main: lines 20px apart) */
  }
  /* Main: browsers set General Sans a hair wider than Figma; 2px of slack keeps the designed line breaks */
  @media (min-width: 48rem) { .rv__body { margin-right: -0.125rem; } }
  .rv__fade {
    position: absolute;
    top: -1.25rem;
    bottom: -3.0625rem;
    right: 0;
    width: clamp(4rem, calc(4rem + 104 * var(--f)), 10.5rem);                  /* 64 -> 168 */
    background: linear-gradient(270deg, var(--c-navy) 0%, rgba(15, 21, 36, 0) 100%);
    pointer-events: none;
  }
  .rv__nav {
    position: absolute;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-top: -1.375rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--c-cream);
  }
  .rv__nav[hidden] { display: none; }
  .rv__nav :global(.rv__navic) { width: 1.125rem; height: auto; }             /* chevron 18 wide in a 36 box */
  .rv__nav--prev { display: none; left: calc(max(0px, (100vw - var(--page-max)) / 2) + 3.625rem - 0.25rem); }   /* x 58 */
  .rv__nav--prev :global(.rv__navic) { transform: rotate(90deg); }
  .rv__nav--next { right: calc(max(0px, (100vw - var(--page-max)) / 2) - 0.0625rem - 0.25rem); }            /* mobile x 355 */
  .rv__nav--next :global(.rv__navic) { transform: rotate(-90deg); }
  .rv__nav:hover { background: rgba(199, 232, 255, 0.12); }

  /* ---------- airlines ---------- */
  .rv__air {
    --air-h: clamp(2.125rem, calc(2.125rem + 30 * var(--f)), 4rem);            /* strip height 34 -> 64 */
    margin-top: calc(1.4375rem * var(--tighten) + 0.5rem);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .rv__air-track { display: flex; width: max-content; }
  .rv__air-track :global(.rv__air-img) {
    display: block; flex: none; width: auto; height: var(--air-h); max-width: none;
    padding-right: calc(var(--air-h) * 1.4);                                     /* the gap between the loops */
  }
  @media (prefers-reduced-motion: no-preference) {
    .rv__air-track { animation: rv-air 55s linear infinite; }
    .rv__air:hover .rv__air-track { animation-play-state: paused; }
  }
  @keyframes rv-air { to { translate: -50% 0; } }

  @media (min-width: 48rem) {
    .rv__head { padding-inline-start: var(--gutter); text-align: center; }
    .rv__h { max-width: 71.0625rem; margin-inline: auto; }                        /* 1137 */
    .rv__h :global(strong) { display: inline; }
    .rv__rating {
      justify-content: center;
      column-gap: 4.75rem;                                                       /* 76 */
      margin: var(--sec-head) 0 0;
      padding-left: 2.75rem;                                                     /* row sits 22px right of centre */
    }
    .rv__tp :global(img) { width: 10.125rem; }                                  /* 162 */
    .rv__rating :global(.rv__stars) { width: 10.1875rem; margin-top: 0; }        /* 163 */
    .rv__label { flex-basis: auto; margin-top: 0; font-size: 1.375rem; }         /* 22 */
    .rv__carousel { margin-top: 4.5625rem; }                                     /* 73 */
    .rv__nav { color: var(--c-sky); }
    .rv__nav--prev { display: flex; }
    .rv__nav--next { right: calc(max(0px, (100vw - var(--page-max)) / 2) + 3.6875rem - 0.25rem); }  /* x 1345 */
    .rv__air { margin-top: calc(6.125rem * var(--tighten)); }
  }
  @media (max-width: 47.99rem) {
    .rv__nav--prev[hidden], .rv__nav--prev { display: none; }
  }
</style>
