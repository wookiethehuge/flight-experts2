---
/**
 * "The Scope of Our Expertise": navy section, champagne-cabin photo softened to an abstract blur under a navy fade, and a
 * numbered list (2 columns on mobile, 3 from 64rem), each number in a thin circle.
 * Client review: the logo-mark watermark was removed and the photo simplified (section felt busy); the numbers got a
 * circular outline so they don't float.
 * Artboards: About (section 1440x625: photo box 962 wide on the right, 53deg fade; H2 48/62 centred; numbers 40/52;
 * items 16/24) and AboutMobile (390x811: photo 390x462 on top, vertical fade; H2 32/33; numbers 32/42; items 14/21).
 */
import type { ExpertiseBlock, SiteSettings } from '../../lib/types';
import { inline } from '../../lib/inline';
import Img from '../ui/Img.astro';

interface Props { block: ExpertiseBlock; settings: SiteSettings; page: string; index: number }
const { block, index } = Astro.props;
const id = `expertise-${index}`;
---
<section class="expertise" aria-labelledby={id}>
  <div class="expertise__media">
    <Img media={block.image} class="expertise__img" sizes="(min-width: 64rem) 67vw, (min-width: 48rem) 100vw, 183vw" widths={[480, 720, 960, 1052]} />
  </div>
  <div class="expertise__inner">
    <h2 class="expertise__title" id={id} set:html={inline(block.heading)} />
    <ol class="expertise__list" role="list">
      {block.items.map((item, i) => (
        <li class="expertise__item" data-reveal style={`--i: ${i}`}>
          <span class="expertise__num" aria-hidden="true">{i + 1}</span>
          <h3 class="expertise__item-title">{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .expertise {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--c-navy);
    color: var(--c-sky);
  }

  /* ---- photo + fade ---- */
  .expertise__media {
    position: absolute;
    inset: 0 0 auto 0;
    height: 28.875rem;                   /* 462 */
    overflow: hidden;
    z-index: -2;
  }
  .expertise__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 21, 36, 0.68) 0%, var(--c-navy) 100%);
  }
  /* 390 frame: the photo is zoomed past "cover" (710.65px wide, offset -137.35 / -253.08 in a 390x462 box) */
  .expertise__media :global(.expertise__img) {
    position: absolute;
    left: -35.22%;
    top: -54.78%;
    width: 182.22%;
    max-width: none;
    height: auto;
  }
  /* abstract, not a scene: the photo is only soft light and colour behind the fade */
  .expertise__media :global(.expertise__img) { filter: blur(18px) saturate(0.7); scale: 1.08; }

  /* ---- content ---- */
  .expertise__inner {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-top: var(--sec-y);
    padding-bottom: var(--sec-y);
    padding-left: clamp(1.5625rem, calc(1.5625rem + 45 * (100vw - 24.375rem) / 1050), 4.375rem);     /* 25 -> 70 */
    padding-right: clamp(0.75rem, calc(0.75rem + 50 * (100vw - 24.375rem) / 1050), 3.875rem);        /* 12 -> 62 */
  }
  .expertise__title {
    max-width: 15rem;                    /* 390: "The Scope of / Our Expertise" */
    font-family: var(--ff-serif);
    font-weight: var(--fw-regular);
    font-size: var(--fs-h2);                                                                        /* 32 -> 48 */
    line-height: clamp(2.0625rem, calc(2.0625rem + 29 * (100vw - 24.375rem) / 1050), 3.875rem);   /* 33 -> 62 */
    color: var(--c-sky);
  }
  .expertise__title :global(em) { font-style: italic; font-weight: var(--fw-light); }

  .expertise__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 0.8125rem;                                                                          /* 13 */
    row-gap: clamp(1.3125rem, calc(1.3125rem + 22 * (100vw - 24.375rem) / 1050), 2.6875rem);        /* 21 -> 43 (rows 192 apart) */
    margin: var(--sec-head) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-body);                                                                      /* 14 -> 16 */
    line-height: clamp(1.3125rem, calc(1.3125rem + 3 * (100vw - 24.375rem) / 1050), 1.5rem);       /* 21 -> 24 */
  }
  /* number in a thin circle (client: an anchor so the numbers don't float) */
  .expertise__num {
    display: grid;
    place-items: center;
    width: clamp(2.5rem, calc(2.5rem + 8 * (100vw - 24.375rem) / 1050), 3rem);                     /* 40 -> 48 */
    aspect-ratio: 1;
    margin-bottom: 0.625rem;
    border: 1px solid color-mix(in srgb, var(--c-sky) 45%, transparent);
    border-radius: 50%;
    font-family: var(--ff-serif);
    font-weight: var(--fw-regular);
    font-size: clamp(1.25rem, calc(1.25rem + 4 * (100vw - 24.375rem) / 1050), 1.5rem);             /* 20 -> 24 */
    line-height: 1;
    font-variant-numeric: lining-nums;
  }
  .expertise__item { max-width: 10.125rem; }   /* 390 frame: text wraps at ~162px inside the 170px columns */
  .expertise__item-title {
    margin-top: clamp(-0.1875rem, calc(-0.1875rem + 6 * (100vw - 24.375rem) / 1050), 0.1875rem);  /* -3 -> 3 */
    font-size: inherit;
    line-height: inherit;
    font-weight: var(--fw-semibold);
  }
  .expertise__item-title { line-height: 1.25; margin-top: 0.25rem; }
  .expertise__item-title + p { margin-top: 0.25rem; }   /* compact heading block (client) */

  @media (min-width: 30rem) {
    .expertise__item { max-width: none; }
  }

  @media (min-width: 48rem) {
    .expertise__media :global(.expertise__img) {
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 46%;
    }
  }

  @media (min-width: 64rem) {
    /* 1440 frame: photo box 962 wide on the right edge, full section height, 53deg fade */
    .expertise__media { inset: 0 0 0 auto; width: 66.81%; height: auto; }
    .expertise__media::after { background: linear-gradient(53deg, var(--c-navy) 25.4%, rgba(15, 21, 36, 0.58) 100%); }
    .expertise__title { max-width: none; margin-right: 0.5rem; text-align: center; }  /* centre on the 1300 content box */
    .expertise__title :global(em) { font-weight: var(--fw-regular); }
    /* three equal columns (client: symmetry), each text box the same width */
    .expertise__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 3rem;
    }
    .expertise__item { max-width: 20.5rem; }
  }
</style>
