---
/**
 * "How it works": four cards (photo / options list / secure checkout / photo) with serif titles and captions, plus
 * the round "Get Flight Options" badge that opens the booking modal.
 * Main (1440): cards 309x439 at x 72/401/730/1059 y 1238, captions 18px 35 below, badge 156 over card 4.
 * Mobile (390): 2x2 grid of 176x250 cards (x 15/199), captions 14/19, badge 100px beside the heading.
 * Cards 2 and 3 were images in the desktop frame; they are drawn here in HTML at desktop scale (kit.py g45/g56) and
 * scaled with the card via container units (1 design px = card width / 309). They are decorative (aria-hidden):
 * the card title and caption carry the meaning.
 */
import type { HowItWorksBlock, SiteSettings } from '../../lib/types';
import { inline } from '../../lib/inline';
import Img from '../ui/Img.astro';
import Icon from '../ui/Icon.astro';
import shieldMask from '../../assets/seed/shield-mask.png';
import { Picture } from 'astro:assets';
// card 1 photo (plane-over-globe) split in layers so it can move: sky (plane painted out), the globe disc, the plane
import gSky from '../../assets/seed/hiw-globe-sky.png';
import gEarth from '../../assets/seed/hiw-globe-earth.png';
import gPlane from '../../assets/seed/hiw-globe-plane.png';

interface Props { block: HowItWorksBlock; settings: SiteSettings; page: string; index: number }
const { block, index } = Astro.props;
const cards = block.cards ?? [];
const cardSizes = '(min-width: 90rem) 309px, (min-width: 64rem) calc((100vw - 9rem) / 4), (min-width: 48rem) calc((100vw - 7rem) / 2), 46vw';
// the layered version is used only while card 1 still shows that photo (seed or CMS); any other image shows as is
const isGlobe = (m: { filename?: string; url: string }) => /plane-over-globe/.test(m.filename ?? m.url);
const hid = `hiw-h-${index}`;
const rows = [0, 64, 130, 196];
const rules = [48, 113, 179, 247];
// "Review your options" card: example fares (client), one set of four shown at a time; the script swaps to the next set
// each time the card replays, so it never looks stale. [from, to, was, now] in USD; the saving is worked out here.
const fareSets: [string, string, number, number][][] = [
  [['New York', 'London', 4850, 3290], ['Boston', 'Paris', 4620, 3180], ['Chicago', 'Frankfurt', 4475, 3095], ['Washington', 'Zurich', 5340, 3710]],
  [['Los Angeles', 'Tokyo', 7260, 4190], ['San Francisco', 'Singapore', 7580, 4580], ['New York', 'Hong Kong', 7120, 4325], ['Chicago', 'Bangkok', 6840, 3975]],
  [['Los Angeles', 'Sydney', 9280, 4990], ['San Francisco', 'Melbourne', 9040, 5185], ['Dallas', 'Brisbane', 9510, 5475], ['Seattle', 'Perth', 10260, 5890]],
  [['New York', 'Johannesburg', 6510, 4485], ['Miami', 'Cape Town', 7240, 4860], ['Washington', 'Cairo', 5175, 3465], ['Chicago', 'Nairobi', 6280, 4215]],
];
const usd = (n: number) => `$${n.toLocaleString('en-US')}`;
const fares = fareSets.map((set) => set.map(([from, to, was, now]) => ({ route: `${from} → ${to}`, was: usd(was), now: usd(now), off: `Save ${Math.round((1 - now / was) * 100)}%` })));
// city lights on the globe card: [x %, y %, delay s]
const cities = [[10.6, 75.9, 0], [53.2, 75, 1.1], [65.3, 70.6, 2.3], [70.7, 78.9, 0.6], [90.5, 86.5, 1.7], [83.2, 89.6, 2.9]];
// smaller, fainter twinkles around the big hubs (New York, Europe), each on a real bright spot of the photo
const sparks = [[7.7, 76, 0.4], [9.4, 76.9, 1.9], [50.8, 74.2, 0.8], [55.3, 74.3, 2.6], [59, 73.9, 1.4], [62.6, 75.9, 3.1], [57.2, 77.1, 0.2], [52.6, 79, 2.1]];
---
<section class="hiw on-light" aria-labelledby={hid}>
  <div class="hiw__inner">
    <h2 class="hiw__h" id={hid} set:html={inline(block.heading)} />
    <div class="hiw__wrap">
      <ol class="hiw__grid" role="list">
        {cards.map((c, i) => (
          <li class="hiw__item" data-reveal style={`--i: ${i}`}>
            <div class:list={['hiw__card', `hiw__card--${c.visual}`, 'lift']}>
              {c.visual === 'image' && c.image && !(i === 0 && isGlobe(c.image)) && (
                <Img media={c.image} class="hiw__img" sizes={cardSizes} widths={[176, 240, 309, 352, 480, 618, 720]} />
              )}
              {/* the plane-over-globe photo, layered: the plane flies in when the card comes into view, then the globe
                  keeps turning (the city lights turn with it) */}
              {c.visual === 'image' && c.image && i === 0 && isGlobe(c.image) && (
                <span class="hiw__g" data-hiw-anim="globe">
                  <span class="hiw__g-stage"><Picture src={gSky} formats={['avif', 'webp']} widths={[240, 309, 480, 618, 720]} sizes={cardSizes} alt={c.image.alt ?? ''} class="hiw__g-sky" /></span>
                  <span class="hiw__g-rot" aria-hidden="true">
                    <span class="hiw__g-stage"><Picture src={gEarth} formats={['avif', 'webp']} widths={[240, 309, 480, 618, 720]} sizes={cardSizes} alt="" class="hiw__g-earth" /></span>
                    <span class="hiw__fx">
                      {cities.map(([x, y, d]) => <span class="hiw__city" style={`--x: ${x}%; --y: ${y}%; --d: ${d}s`} />)}
                      {sparks.map(([x, y, d]) => <span class="hiw__city hiw__city--s" style={`--x: ${x}%; --y: ${y}%; --d: ${d}s`} />)}
                    </span>
                  </span>
                  <span class="hiw__g-stage" aria-hidden="true"><span class="hiw__g-jet"><Picture src={gPlane} formats={['avif', 'webp']} widths={[240, 309, 480, 618, 720]} sizes={cardSizes} alt="" class="hiw__g-plane" /></span></span>
                </span>
              )}
              {/* ambient light (client): city lights switching on across the globe on the first card, a glint on the
                  glass on the last; positions are % of the card (fixed 309:439 aspect, image object-fit cover) */}
              {c.visual === 'image' && i === 0 && !(c.image && isGlobe(c.image)) && (
                <span class="hiw__fx" aria-hidden="true">
                  {cities.map(([x, y, d]) => <span class="hiw__city" style={`--x: ${x}%; --y: ${y}%; --d: ${d}s`} />)}
                  {sparks.map(([x, y, d]) => <span class="hiw__city hiw__city--s" style={`--x: ${x}%; --y: ${y}%; --d: ${d}s`} />)}
                </span>
              )}
              {c.visual === 'image' && i === cards.length - 1 && i > 0 && (
                <span class="hiw__fx" aria-hidden="true">
                  <span class="hiw__glint" style="--x: 51.6%; --y: 48.6%" />
                </span>
              )}
              {c.visual === 'options' && (
                <div class="hiw__art" aria-hidden="true" data-hiw-anim="options">
                  <div class="opt" data-fares={JSON.stringify(fares)}>
                    {rows.map((y, k) => (
                      <div class="opt__row" style={`--y: ${y}; --k: ${k}`}>
                        <Icon name="flight" class="opt__plane" />
                        <span class="opt__route" data-f="route">{fares[0][k].route}</span>
                        <span class="opt__cabin">Business Class</span>
                        <span class="opt__now" data-f="now">{fares[0][k].now}</span>
                        <span class="opt__sub"><s class="opt__was" data-f="was">{fares[0][k].was}</s> <span class="opt__off" data-f="off">{fares[0][k].off}</span></span>
                      </div>
                    ))}
                    {rules.map((y, k) => <span class="opt__rule" style={`--y: ${y}; --k: ${k}`} />)}
                  </div>
                </div>
              )}
              {c.visual === 'checkout' && (
                <div class="hiw__art" aria-hidden="true" data-hiw-anim="checkout">
                  <div class="chk" style={`--shield: url(${shieldMask.src})`}>
                    <span class="chk__shield" />
                    <span class="chk__t chk__head">Secure checkout</span>
                    <span class="chk__box" />
                    <span class="chk__rule" style="--y: 78" />
                    <span class="chk__rule" style="--y: 126" />
                    <span class="chk__rule" style="--y: 174" />
                    <Icon name="flight" class="chk__ic chk__ic--1" />
                    <Icon name="person" class="chk__ic chk__ic--2" />
                    <Icon name="card" class="chk__ic chk__ic--3" />
                    <span class="chk__t chk__b" style="--x: 43; --y: 40">New York &gt; London</span>
                    <span class="chk__t" style="--x: 43; --y: 56">Business</span>
                    <span class="chk__t chk__b" style="--x: 43; --y: 93">1 Traveler</span>
                    <span class="chk__t chk__b chk__dots" style="--x: 43; --y: 141">••••</span>
                    <span class="chk__t chk__b" style="--x: 84; --y: 143">2841</span>
                    <Icon name="chevron-right" class="chk__chev" />
                    <span class="chk__t chk__b chk__link" style="--x: 30; --y: 189">Passenger &amp; payment details</span>
                    <span class="chk__btn">
                      <span class="chk__state chk__state--idle">Confirm booking</span>
                      <span class="chk__state chk__state--busy"><span class="chk__spin" />Securing your booking…</span>
                      <span class="chk__state chk__state--done">
                        <svg class="chk__tick" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7.25" stroke="currentColor" stroke-width="1.5" /><path d="M4.75 8.25 7 10.5l4.25-4.75" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        Booking confirmed
                      </span>
                    </span>
                  </div>
                </div>
              )}
              <h3 class:list={['hiw__title', c.visual === 'image' && 'hiw__title--light']}>{c.title}</h3>
            </div>
            <p class="hiw__cap">{c.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .hiw {
    --f: calc((100vw - 24.375rem) / 1050);
    --hg: clamp(0.9375rem, calc(0.9375rem + 57 * var(--f)), 4.5rem);       /* side gutter 15 -> 72 */
    --gap: clamp(0.5rem, calc(0.5rem + 12 * var(--f)), 1.25rem);           /* 8 -> 20 */
    padding-block: var(--sec-y);
    color: var(--c-navy);
  }
  .hiw__inner { max-width: var(--page-max); margin-inline: auto; padding-inline: var(--hg); }
  .hiw__h {
    font-family: var(--ff-serif);
    font-weight: var(--fw-regular);
    font-size: var(--fs-h2);                                                 /* 32 -> 48 */
    line-height: clamp(2.625rem, calc(2.625rem + 20.4 * var(--f)), 3.9rem);  /* 42 -> 62.4 */
    color: var(--c-navy);
  }
  .hiw__h :global(em) { font-style: italic; }
  .hiw__wrap {
    position: relative;
    container-type: inline-size;                                             /* badge placement uses the grid width */
    margin-top: var(--sec-head);
  }
  .hiw__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5625rem var(--gap);                                               /* rows 25 apart on mobile */
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hiw__item { display: flex; flex-direction: column; min-width: 0; }

  /* ---------- cards ---------- */
  .hiw__card {
    position: relative;
    aspect-ratio: 309 / 439;
    border-radius: var(--r-card-photo);
    isolation: isolate;
  }
  .hiw__card--options, .hiw__card--checkout {
    container-type: inline-size;
    border: 1px solid var(--c-navy);
    overflow: hidden;
  }
  .hiw__card :global(.hiw__img) {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--r-card-photo);   /* set directly: the <img> sits in a <picture>, so `inherit` gave square corners */
  }
  .hiw__card--image { overflow: hidden; }

  /* ---------- card 1, layered photo: plane flies in, globe turns ---------- */
  .hiw__g { position: absolute; z-index: -2; inset: 0; overflow: hidden; border-radius: var(--r-card-photo); }
  /* the photo's own box (1065 x 1476), height-fitted and centred like object-fit: cover in the 309:439 card */
  .hiw__g-stage { position: absolute; top: 0; left: 50%; height: 100%; aspect-ratio: 1065 / 1476; translate: -50% 0; }
  .hiw__g-sky { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* globe layer: the disc + a soft band above its rim (with the flight-arc tails above it; extended past the photo edges); turns around the globe's centre,
     which is below the card (49.67%, 106.88% of the card). The city lights sit in the same turning layer. */
  .hiw__g-rot { position: absolute; inset: 0; transform-origin: 49.67% 106.88%; }
  .hiw__g-earth { position: absolute; left: -15.023%; top: 48.713%; width: 130.047%; max-width: none; height: 58.74%; }   /* reaches past the photo (filled from the globe itself) so turning never shows an edge */
  .hiw__g-jet { position: absolute; left: 0; top: 18.767%; width: 95.775%; height: 22.222%; }
  .hiw__g-plane { position: absolute; inset: 0; width: 100%; height: 100%; }
  @media (prefers-reduced-motion: no-preference) {
    /* turns 7deg each way around its centre: the cap visibly slides past, as the earth turning */
    .hiw__g-rot { animation: hiw-turn 12s ease-in-out infinite alternate; }
    /* waiting below-left, off the card; flies up into place when the card is half in view (data-play), then floats */
    :global(html.js) .hiw__g .hiw__g-jet {
      opacity: 0; translate: -75% 70%; scale: 0.7;
      transition: opacity 500ms ease, translate 0s linear 500ms, scale 0s linear 500ms;
    }
    :global(html.js) .hiw__g[data-play] .hiw__g-jet {
      opacity: 1; translate: none; scale: none;
      transition: opacity 700ms ease, translate 2.2s cubic-bezier(0.16, 1, 0.3, 1), scale 2.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .hiw__g-plane { animation: hiw-float 5s ease-in-out 2.2s infinite alternate; }
    .hiw__item:not(.is-visible) :is(.hiw__g-rot, .hiw__g-plane) { animation-play-state: paused; }
  }
  @keyframes hiw-turn { from { rotate: -7deg; } to { rotate: 7deg; } }
  @keyframes hiw-float { from { translate: 0 0; } to { translate: 0.8% -4%; } }
  .hiw__card--image::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(179.78deg, rgba(0, 0, 0, 0) 70.4%, rgba(0, 0, 0, 0.2) 99.9%);
  }
  .hiw__item:nth-child(4) .hiw__card--image::after {
    background: linear-gradient(29.3deg, rgba(0, 0, 0, 0.76) 10%, rgba(0, 0, 0, 0) 45.7%);
  }
  .hiw__title {
    position: absolute;
    left: clamp(0.9375rem, calc(0.9375rem + 21 * var(--f)), 2.25rem);        /* 15 -> 36 */
    bottom: clamp(1.0625rem, calc(1.0625rem + 27.3 * var(--f)), 2.7688rem);  /* last baseline 20 -> 48 above the edge */
    max-width: clamp(9.375rem, calc(9.375rem + 50 * var(--f)), 12.5rem);     /* 150 -> 200: two lines as drawn */
    font-family: var(--ff-serif);
    font-size: clamp(1.475rem, calc(1.475rem + 7.9 * var(--f)), 1.9688rem);   /* 23.6 -> 31.5 */
    line-height: clamp(1.4375rem, calc(1.4375rem + 8 * var(--f)), 1.9375rem);  /* 23 -> 31 */
    font-weight: var(--fw-semibold);
    color: var(--c-navy);
  }
  .hiw__title--light { color: rgba(255, 255, 255, 0.88); }
  /* card 1 breaks "Tell us your / plans" at 390 but "Tell us / your plans" at 1440 (Mobile / Main) */
  .hiw__item:nth-child(1) .hiw__title { max-width: clamp(9.375rem, calc(9.375rem + 22 * var(--f)), 10.75rem); }  /* 150 -> 172 */
  /* "Review your options" starts at x 10 (Mobile) / 31 (Main) and "Travel stress-free" at 11 / 47 inside their cards */
  .hiw__item:nth-child(2) .hiw__title { left: clamp(0.625rem, calc(0.625rem + 21 * var(--f)), 1.9375rem); }     /* 10 -> 31 */
  .hiw__item:nth-child(4) .hiw__title { left: clamp(0.6875rem, calc(0.6875rem + 36 * var(--f)), 2.9375rem); }   /* 11 -> 47 */
  .hiw__cap {
    margin-top: clamp(0.8rem, calc(0.8rem + 22.2 * var(--f)), 2.1875rem);     /* 12.8 -> 35 */
    padding-inline: clamp(0.1875rem, calc(0.9375rem - 12 * var(--f)), 0.9375rem); /* 15 -> 3 */
    max-width: var(--cap-w);
    font-size: clamp(0.875rem, calc(0.875rem + 4 * var(--f)), 1.125rem);     /* 14 -> 18 */
    line-height: 1.35;
    color: var(--c-black);
  }
  .hiw__item { --cap-w: 100%; }   /* every caption spans its card (client: symmetry) */

  /* ---------- ambient light on the photo cards ---------- */
  .hiw__fx { position: absolute; inset: 0; z-index: 0; overflow: hidden; border-radius: inherit; pointer-events: none; }
  .hiw__city {
    position: absolute; left: var(--x); top: var(--y);
    width: 3.5px; height: 3.5px; margin: -1.75px 0 0 -1.75px;
    border-radius: 50%;
    background: #fff6e0;
    box-shadow: 0 0 3px 1px rgba(255, 220, 150, 0.8), 0 0 10px 3px rgba(255, 190, 90, 0.25);
    opacity: 0;
  }
  .hiw__city--s {
    --o: 0.55;
    width: 2.2px; height: 2.2px; margin: -1.1px 0 0 -1.1px;
    box-shadow: 0 0 2px 0.5px rgba(255, 220, 150, 0.8), 0 0 6px 1.5px rgba(255, 190, 90, 0.2);
  }
  /* light passing over the glass: a thin, soft vertical sheen that slides across its body, as a real reflection
     would (no icon shape); screen blend so it only ever brightens the glass */
  .hiw__glint {
    position: absolute; left: var(--x); top: var(--y);
    width: 3px; height: 9%; translate: -50% -50%;
    border-radius: 2px;
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.85) 30%, rgba(255, 255, 255, 0.85) 70%, transparent);
    filter: blur(0.8px);
    rotate: 4deg;
    mix-blend-mode: screen;
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hiw__city { animation: hiw-city 3.2s ease-in-out calc(var(--d) * 0.6) infinite; }
    .hiw__city:nth-child(even) { animation-duration: 3.9s; }   /* two rhythms, so they never pulse in step */
    .hiw__glint { animation: hiw-glint 7s cubic-bezier(0.45, 0, 0.55, 1) 2s infinite; }
    /* nothing runs while the section is off screen */
    .hiw__item:not(.is-visible) :is(.hiw__city, .hiw__glint) { animation-play-state: paused; }
  }
  @keyframes hiw-city {
    0%, 100% { opacity: 0; }
    42%, 54% { opacity: var(--o, 0.7); }
  }
  @keyframes hiw-glint {
    0%, 58%, 100% { opacity: 0; translate: calc(-50% - 13px) -50%; }
    68%, 76% { opacity: 0.75; }
    88% { opacity: 0; translate: calc(-50% + 13px) -50%; }
  }

  /* ---------- drawn cards (1 design px = card width / 309) ---------- */
  .hiw__art { --u: calc(100cqi / 309); position: absolute; inset: 0; pointer-events: none; }
  .opt, .chk {
    position: absolute;
    top: calc(50 * var(--u));
    font-size: calc(12 * var(--u));
    line-height: calc(16 * var(--u));
    color: var(--c-navy);
    white-space: nowrap;
  }
  .opt { left: calc(31 * var(--u)); width: calc(247 * var(--u)); height: calc(248 * var(--u)); }
  .opt__row { position: absolute; left: 0; right: 0; top: calc(var(--y) * var(--u)); height: calc(32 * var(--u)); }
  .opt__row > :global(*) { position: absolute; }
  .opt__row :global(.opt__plane) { left: 0; top: calc(6 * var(--u)); width: calc(20 * var(--u)); height: calc(20 * var(--u)); }
  .opt__route { left: calc(31 * var(--u)); top: 0; font-weight: var(--fw-semibold); }
  .opt__cabin { left: calc(31 * var(--u)); top: calc(16 * var(--u)); }
  /* right column: the fare on top, the old fare struck through + the saving under it (fits the longest routes) */
  .opt__now { right: 0; top: 0; font-weight: var(--fw-semibold); }
  .opt__sub { right: 0; top: calc(16 * var(--u)); }
  .opt__was { color: var(--c-navy-60); }
  .opt__off { margin-left: calc(3 * var(--u)); color: #1d7340; font-weight: var(--fw-semibold); }   /* green, 5.3:1 on cream */
  .opt__rule { position: absolute; left: 0; width: 100%; top: calc(var(--y) * var(--u)); height: 1px; background: var(--c-sky); }

  .chk { left: calc(34 * var(--u)); width: calc(241 * var(--u)); height: calc(265 * var(--u)); }
  .chk > :global(*) { position: absolute; }
  .chk__shield {
    left: 0; top: 0; width: calc(16 * var(--u)); height: calc(16 * var(--u));
    background: var(--c-burgundy);
    -webkit-mask: var(--shield) center / contain no-repeat;
    mask: var(--shield) center / contain no-repeat;
  }
  .chk__t { left: calc(var(--x, 0) * var(--u)); top: calc(var(--y, 0) * var(--u)); }
  .chk__head { --x: 23; --y: 0; font-weight: var(--fw-semibold); }
  .chk__b { font-weight: var(--fw-semibold); }
  .chk__dots { letter-spacing: calc(2.4 * var(--u)); }
  .chk__link { color: var(--c-burgundy); }
  .chk__box { left: 0; top: calc(29 * var(--u)); width: 100%; height: calc(193 * var(--u)); border: 1px solid var(--c-sky); border-radius: var(--r-3); }
  .chk__rule { left: 0; top: calc(var(--y) * var(--u)); width: calc(240 * var(--u)); height: 1px; background: var(--c-sky); }
  .chk :global(.chk__ic) { left: calc(10 * var(--u)); width: calc(18 * var(--u)); height: calc(18 * var(--u)); }
  .chk :global(.chk__ic--1) { top: calc(43 * var(--u)); }
  .chk :global(.chk__ic--2) { top: calc(91 * var(--u)); }
  .chk :global(.chk__ic--3) { top: calc(141 * var(--u)); }
  .chk :global(.chk__chev) { left: calc(11 * var(--u)); top: calc(190.5 * var(--u)); width: calc(8 * var(--u)); height: calc(13 * var(--u)); color: var(--c-burgundy); }
  .chk__btn {
    left: 0; top: calc(225 * var(--u)); width: 100%; height: calc(40 * var(--u));
    display: flex; align-items: center; justify-content: center;
    border-radius: var(--r-3);
    background: var(--c-burgundy);
    color: var(--c-cream);
    font-weight: var(--fw-semibold);
    overflow: hidden;
    transition: transform 140ms var(--ease), background-color 300ms var(--ease);
  }
  /* button states (client animation brief): idle "Confirm booking" -> pressed -> "Securing your booking…" with a small
     spinner -> tick + "Booking confirmed". Only the idle label shows without JS / with reduced motion. */
  .chk__state {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center; gap: calc(7 * var(--u));
    transition: opacity 380ms var(--ease), translate 380ms var(--ease);
  }
  .chk__state--busy, .chk__state--done { opacity: 0; translate: 0 calc(8 * var(--u)); }
  .chk__spin {
    width: calc(11 * var(--u)); height: calc(11 * var(--u));
    border: calc(1.5 * var(--u)) solid color-mix(in srgb, var(--c-cream) 35%, transparent);
    border-top-color: var(--c-cream);
    border-radius: 50%;
    animation: chk-spin 700ms linear infinite;
  }
  .chk__tick { width: calc(14 * var(--u)); height: calc(14 * var(--u)); flex: none; }
  .chk[data-state='pressed'] .chk__btn { transform: scale(0.96); background: var(--c-burgundy-hover); }
  .chk[data-state='busy'] .chk__btn, .chk[data-state='done'] .chk__btn { background: var(--c-burgundy-hover); }
  .chk[data-state='busy'] .chk__state--idle, .chk[data-state='done'] .chk__state--idle { opacity: 0; translate: 0 calc(-8 * var(--u)); }
  .chk[data-state='busy'] .chk__state--busy { opacity: 1; translate: none; }
  .chk[data-state='done'] .chk__state--busy { opacity: 0; translate: 0 calc(-8 * var(--u)); }
  .chk[data-state='done'] .chk__state--done { opacity: 1; translate: none; }
  .chk[data-state='done'] .chk__tick path { stroke-dasharray: 12; stroke-dashoffset: 12; animation: chk-draw 360ms 120ms var(--ease) forwards; }
  @keyframes chk-spin { to { rotate: 1turn; } }
  @keyframes chk-draw { to { stroke-dashoffset: 0; } }

  /* options appear one by one (client animation brief); hidden start state only with JS + motion allowed */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) [data-hiw-anim='options']:not([data-play]) :is(.opt__row, .opt__rule) { opacity: 0; translate: 0 calc(10 * var(--u)); }
    [data-hiw-anim='options'] :is(.opt__row, .opt__rule) { transition: opacity 450ms var(--ease), translate 450ms var(--ease); }
    [data-hiw-anim='options'][data-play] :is(.opt__row, .opt__rule) {
      transition-duration: 650ms;
      transition-delay: calc(200ms + var(--k) * 340ms);              /* stagger only on the way in */
    }
  }


  @media (min-width: 48rem) {
    .hiw__grid { row-gap: 2.5rem; }
  }
  @media (min-width: 64rem) {
    .hiw__h { text-align: center; }
    .hiw__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>

<script>
  // How it works animations: play when the card is half in view and replay every 10s while it stays in view;
  // reset once it has fully left so they start over on the way back
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const timers = new WeakMap<Element, number[]>();
    const clear = (el: Element) => { (timers.get(el) ?? []).forEach(clearTimeout); timers.set(el, []); };
    const later = (el: Element, ms: number, fn: () => void) => timers.get(el)!.push(window.setTimeout(fn, ms));
    const play = (art: HTMLElement) => {
      clear(art);
      // globe card: the plane flies in once and stays (the globe turns on its own); no 10s replay
      if (art.dataset.hiwAnim === 'globe') { art.setAttribute('data-play', ''); return; }
      const chk = art.querySelector<HTMLElement>('.chk');
      if (art.dataset.hiwAnim === 'options') art.setAttribute('data-play', '');
      else if (chk) {
        later(art, 1900, () => (chk.dataset.state = 'pressed'));     // after the options have landed
        later(art, 2150, () => (chk.dataset.state = 'busy'));
        later(art, 4000, () => (chk.dataset.state = 'done'));
      }
      // every 10s: back to the start state (fade out), then play again; the options card shows the next fares
      later(art, 9400, () => { art.removeAttribute('data-play'); if (chk) delete chk.dataset.state; });
      later(art, 9900, () => nextFares(art));
      later(art, 10000, () => play(art));
    };
    const nextFares = (art: HTMLElement) => {
      const opt = art.querySelector<HTMLElement>('[data-fares]');
      if (!opt) return;
      const sets = JSON.parse(opt.dataset.fares!) as Record<string, string>[][];
      const n = (Number(opt.dataset.set ?? 0) + 1) % sets.length;
      opt.dataset.set = String(n);
      opt.querySelectorAll('.opt__row').forEach((row, k) => {
        row.querySelectorAll<HTMLElement>('[data-f]').forEach((el) => { el.textContent = sets[n][k][el.dataset.f!]; });
      });
    };
    const reset = (art: HTMLElement) => {
      clear(art);
      art.removeAttribute('data-play');
      const chk = art.querySelector<HTMLElement>('.chk');
      if (chk) delete chk.dataset.state;
    };
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const art = e.target as HTMLElement;
        if (e.intersectionRatio >= 0.5) { if (!art.hasAttribute('data-played')) { art.setAttribute('data-played', ''); play(art); } }
        else if (!e.isIntersecting) { art.removeAttribute('data-played'); reset(art); }
      }
    }, { threshold: [0, 0.5] });
    document.querySelectorAll<HTMLElement>('[data-hiw-anim]').forEach((el) => { timers.set(el, []); io.observe(el); });
  }
</script>
