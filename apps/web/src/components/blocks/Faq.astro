---
/**
 * FAQ accordion (home #faq band, contact page). Native <details>/<summary>: works without JS, keyboard operable.
 * The first item starts open (design). Values: Main (1440) / Mobile (390) FAQ band; Contact / ContactMobile match.
 * `heading` is optional; ids are index based so the block can appear on any page.
 */
import type { FaqBlock, SiteSettings } from '../../lib/types';
import { inline } from '../../lib/inline';
import Icon from '../ui/Icon.astro';

interface Props { block: FaqBlock; settings: SiteSettings; page: string; index: number }
const { block, index, page } = Astro.props;
const items = block.items ?? [];
const hid = `faq-h-${index}`;
---
<section class:list={['faq', 'on-light', { 'faq--contact': page === 'contact' }]} id="faq" aria-labelledby={block.heading ? hid : undefined} aria-label={block.heading ? undefined : 'Frequently asked questions'}>
  <div class="container faq__inner">
    {block.heading && <h2 class="faq__h" id={hid} set:html={inline(block.heading)} />}
    <div class="faq__list">
      {items.map((item, i) => (
        <details class="faq__item" open={i === 0} data-reveal="subtle" style={`--i: ${i}`}>
          <summary class="faq__q">
            <span class="faq__qt">{item.question}</span>
            <Icon name="chevron-down" class="faq__chev" />
          </summary>
          <div class="faq__a">
            <div class="faq__at" set:html={inline(item.answer)} />
            <span class="faq__close" data-faq-close aria-hidden="true"><Icon name="chevron-down" class="faq__chev faq__chev--up" /></span>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  // The up-chevron inside an open answer card closes it (pointer convenience; the summary stays the keyboard control).
  document.addEventListener('click', (e) => {
    const t = (e.target as Element | null)?.closest?.('[data-faq-close]');
    const d = t?.closest('details');
    if (d) d.open = false;
  });
</script>

<style>
  .faq {
    --f: calc((100vw - 24.375rem) / 1050);
    background: var(--c-sky-59);
    /* 52 -> 62 top, 35 -> 98 bottom */
    padding-block: clamp(3.25rem, calc(3.25rem + 10 * var(--f)), 3.875rem) clamp(2.1875rem, calc(2.1875rem + 63 * var(--f)), 6.125rem);
    scroll-margin-top: 1rem;
  }
  /* Contact / ContactMobile: heading sits 44 (390) -> 77 (1440) below the band top (home: 52 -> 62) */
  .faq--contact { padding-top: clamp(2.75rem, calc(2.75rem + 33 * var(--f)), 4.8125rem); }
  /* mobile content sits 5px inside the 20px gutter (x 25) */
  .faq__inner { padding-inline-start: calc(var(--gutter) + clamp(0rem, calc(0.3125rem - 5 * var(--f)), 0.3125rem)); }
  .faq__h {
    font-family: var(--ff-serif);
    font-weight: var(--fw-regular);
    font-size: var(--fs-h2);                                                    /* 32 -> 48 */
    line-height: clamp(2.0625rem, calc(2.0625rem + 29 * var(--f)), 3.875rem);   /* 33 -> 62 */
    color: var(--c-navy-ink);
    max-width: 7.9063em;                                                        /* 253 at 32px: 2 lines on mobile, scales with the fluid size */
  }
  .faq__h :global(em) { font-style: italic; }
  .faq__list {
    --chev-in: clamp(0.8125rem, calc(0.8125rem + 43 * var(--f)), 3.5rem);        /* chevron to card edge 13 -> 56 */
    max-width: 76.1875rem;                                                      /* answer card 1219 */
    margin-top: clamp(1.625rem, calc(1.8125rem - 3 * var(--f)), 1.8125rem);     /* 29 -> 26 */
    margin-inline-end: 1px;
  }
  .faq__item + .faq__item { margin-top: clamp(0.8125rem, calc(0.8125rem + 5 * var(--f)), 1.125rem); }   /* 13 -> 18 */
  .faq__item[open] + .faq__item { margin-top: clamp(1.5625rem, calc(1.5625rem + 6 * var(--f)), 1.9375rem); } /* 25 -> 31 */
  .faq__q {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 2.5rem;                                                         /* 40 */
    padding-inline-end: var(--chev-in);
    list-style: none;
    cursor: pointer;
    font-size: clamp(0.875rem, calc(0.875rem + 4 * var(--f)), 1.125rem);        /* 14 -> 18 */
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    color: var(--c-navy);
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q::marker { content: ''; }
  .faq__qt { flex: 1; }
  .faq__q :global(.faq__chev), .faq__close :global(.faq__chev) {
    flex-shrink: 0;
    width: clamp(0.75rem, calc(0.75rem + 6 * var(--f)), 1.125rem);              /* 12 -> 18 */
    height: auto;
    color: var(--c-navy);
  }
  .faq__item[open] .faq__q :global(.faq__chev) { visibility: hidden; }
  .faq__q:hover .faq__qt { text-decoration: underline; text-underline-offset: 3px; }
  .faq__a {
    display: flex;
    align-items: flex-start;
    gap: 1.375rem;
    margin-top: clamp(1.125rem, calc(1.125rem + 2 * var(--f)), 1.25rem);        /* 18 -> 20 */
    padding: clamp(0.875rem, calc(0.875rem + 13 * var(--f)), 1.6875rem) var(--chev-in) clamp(0.875rem, calc(0.875rem + 13 * var(--f)), 1.6875rem) 2.1875rem;
    border-radius: var(--r-7);
    box-shadow: var(--sh-card);
    background: linear-gradient(160.67deg, rgba(255, 255, 255, 0.429) 39.482%, rgba(255, 255, 255, 0.65) 60.518%);
  }
  .faq__at {
    flex: 1;
    max-width: clamp(16.375rem, calc(16.375rem + 627 * var(--f)), 55.5625rem);  /* 262 -> 889 */
    font-size: clamp(0.875rem, calc(0.875rem + 2 * var(--f)), 1rem);            /* 14 -> 16 */
    line-height: clamp(1.1875rem, calc(1.1875rem + 3 * var(--f)), 1.375rem);     /* 19 -> 22 */
    color: var(--c-navy);
  }
  .faq__at :global(a) { color: inherit; }
  .faq__close { margin-left: auto; display: flex; cursor: pointer; padding-top: 0.25rem; }
  .faq__close :global(.faq__chev--up) { transform: rotate(180deg); }
  @media (min-width: 48rem) {
    .faq__h { max-width: none; }
  }
  @media (min-width: 64rem) {
    .faq__a { align-items: center; }
    .faq__close { padding-top: 0; }
  }
</style>
