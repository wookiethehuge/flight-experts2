---
/**
 * Long-form rich text (Terms, Privacy and other text pages). The page H1 comes from page.heading (PageHeading).
 * Artboards: TextPage (1440: body 16/24, subheadings General Sans 600 22/30; 70px gutter) and TextPageMobile
 * (390: body 14/21, subheadings 18/21; 24px gutter). As in the frames, consecutive paragraphs have no extra gap;
 * subheadings carry the spacing. Lists, links and quotes (not in the frames) follow the same scale; the quote box
 * matches the Author page quote.
 */
import type { RichTextBlock, SiteSettings } from '../../lib/types';
import { richText } from '../../lib/richtext';

interface Props { block: RichTextBlock; settings: SiteSettings; page: string; index: number }
const { block } = Astro.props;
const html = richText(block.content);
---
{html && (
  <section class="rt-wrap on-light">
    <div class="rt" set:html={html} />
  </section>
)}

<style>
  .rt-wrap {
    width: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-left: clamp(1.5rem, calc(1.5rem + 46 * (100vw - 24.375rem) / 1050), 4.375rem);          /* 24 -> 70 */
    padding-right: clamp(1.25rem, calc(1.25rem + 50 * (100vw - 24.375rem) / 1050), 4.375rem);       /* 20 -> 70 (390 frame: 24 left, 20 right) */
    padding-top: clamp(1.5rem, calc(1.5rem + 3.84 * (100vw - 24.375rem) / 1050), 1.74rem);          /* 24 -> 27.84 below the H1 */
    /* + the footer's own 78/150px offset = the frames' gap from the last line to the footer arc (114.9 / 255.2) */
    padding-bottom: calc(clamp(2.3056rem, calc(2.3056rem + 68.27 * (100vw - 24.375rem) / 1050), 6.5725rem) * var(--tighten));  /* 36.9 -> 105.2 */
  }
  .rt {
    max-width: 66.25rem;                /* 1060: lines wrap as in the 1440 frame */
    font-size: var(--fs-body);                                                                       /* 14 -> 16 */
    line-height: clamp(1.3125rem, calc(1.3125rem + 3 * (100vw - 24.375rem) / 1050), 1.5rem);        /* 21 -> 24 */
    color: var(--c-navy);
    overflow-wrap: break-word;
  }
  .rt :global(h2),
  .rt :global(h3),
  .rt :global(h4) {
    margin-top: 2.0625rem;                                                                           /* 33 */
    margin-bottom: clamp(0.5938rem, calc(0.5938rem + 3.8 * (100vw - 24.375rem) / 1050), 0.8313rem); /* 9.5 -> 13.3 */
    font-family: var(--ff-sans);
    font-weight: var(--fw-semibold);
    color: var(--c-navy);
  }
  .rt :global(h2) {
    font-size: clamp(1.125rem, calc(1.125rem + 4 * (100vw - 24.375rem) / 1050), 1.375rem);          /* 18 -> 22 */
    line-height: clamp(1.3125rem, calc(1.3125rem + 9 * (100vw - 24.375rem) / 1050), 1.875rem);      /* 21 -> 30 */
  }
  .rt :global(h3) {
    font-size: clamp(1rem, calc(1rem + 2 * (100vw - 24.375rem) / 1050), 1.125rem);                  /* 16 -> 18 */
    line-height: 1.35;
  }
  .rt :global(h4) { font-size: inherit; line-height: inherit; }
  .rt > :global(:first-child) { margin-top: 0; }

  .rt :global(ul),
  .rt :global(ol) { margin: 0.75em 0; padding-left: 1.25em; }
  .rt :global(li + li) { margin-top: 0.25em; }
  .rt :global(li::marker) { color: var(--c-burgundy); }

  .rt :global(a) {
    color: var(--c-burgundy);
    font-weight: var(--fw-medium);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .rt :global(a:hover) { text-decoration-thickness: 2px; }
  .rt :global(strong) { font-weight: var(--fw-semibold); }

  .rt :global(blockquote) {
    margin: 1.25rem 0;
    padding: 0.625rem 1.25rem;                                                                       /* 10 20 */
    border-radius: 4px;
    background: color-mix(in srgb, var(--c-sky) 63%, transparent);
    font-size: var(--fs-16);
    line-height: 1.5rem;
  }
  .rt :global(hr) { margin: 2rem 0; border: 0; border-top: 1px solid var(--c-border-soft); }
</style>
