---
/**
 * Confirmation block: the thank-you hero shown after an enquiry (quote form, contact form) is sent.
 *
 * Block shape (ConfirmationBlock in lib/types.ts):
 *   heading     Inline  "Your Request Is Confirmed!" (page H1, IBM Plex Serif medium)
 *   subheading  string  bold line under the heading ("Thank you for choosing Flight-Experts.")
 *   body        string  short paragraph
 *   button      Link    { label: "Return to Homepage", href: "/" } (outline button, under the call button)
 *
 * Laid out like the trip checkout confirmation (client: same wording style): tick, heading, thanks, a grey
 * "Your Flight Options" box, "We're Here If You Need Us" with the general line (Site Settings > phone) as a burgundy
 * button, then a small note. The box, help text and note are fixed copy adapted for an enquiry: nothing has been paid
 * and no agent is assigned yet, so there is no payment paragraph and no direct-line box.
 */
import type { ConfirmationBlock, SiteSettings } from '../../lib/types';
import { inline } from '../../lib/inline';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props { block: ConfirmationBlock; settings: SiteSettings; page: string; index: number }
const { block, settings } = Astro.props;
---
<section class="confirm container on-light" aria-labelledby={`confirm-h-${Astro.props.index}`}>
  <svg class="confirm__ico" viewBox="0 0 24 24" width="44" height="44" aria-hidden="true"><circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="m7.5 12.3 3 3 6-6.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
  <h1 id={`confirm-h-${Astro.props.index}`} class="confirm__title" set:html={inline(block.heading)} />
  {block.subheading && <p class="confirm__sub">{block.subheading}</p>}
  {block.body && <p class="confirm__body">{block.body}</p>}

  <div class="confirm__box">
    <h2 class="confirm__h3"><Icon name="flight" width={18} height={18} />Your Flight Options</h2>
    <p>A dedicated travel expert will contact you shortly to go over your route, dates and preferences.</p>
    <p>Your tailored flight options will follow once we understand exactly what you need. <strong>There is nothing to pay</strong> until you choose your flights.</p>
  </div>

  {settings.phone?.href && (
    <>
      <h2 class="confirm__h3 confirm__h3--c">We're Here If You Need Us</h2>
      <p class="confirm__help">Our travel experts are available to assist you with any questions about your request.</p>
    </>
  )}
  <div class="confirm__actions">
    {settings.phone?.href && (
      <a class="confirm__line" href={settings.phone.href} aria-label={`Call the Flight-Experts general line: ${settings.phone.display}`}>
        <span>Flight-Experts General Line</span>
        <strong><Icon name="phone" width={16} height={16} />{settings.phone.display}</strong>
      </a>
    )}
    {block.button?.href && <Button href={block.button.href} variant="outline" width="100%" class="confirm__btn">{block.button.label}</Button>}
  </div>
  <p class="confirm__note">Your trip is not booked until you confirm your flight options and your e-ticket has been issued.</p>
</section>

<style>
  .confirm {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 48rem;
    padding-top: var(--page-top);
    padding-bottom: var(--sec-y);
    text-align: center;
    color: var(--c-navy);
  }
  .confirm__ico { color: #1d7340; }                                                                /* green tick, 5.3:1 on cream */
  .confirm__title {
    margin-top: 1rem;
    font-family: var(--ff-serif);
    font-weight: var(--fw-medium);
    font-size: clamp(2rem, calc(2rem + 24 * (100vw - 24.375rem) / 1050), 3.5rem);                 /* 32 -> 56 */
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--c-navy);
    text-wrap: balance;
  }
  .confirm__sub {
    margin-top: 1rem;
    font-size: clamp(1rem, calc(1rem + 2 * (100vw - 24.375rem) / 1050), 1.125rem);                /* 16 -> 18 */
    line-height: 1.4;
    font-weight: var(--fw-semibold);
  }
  .confirm__body, .confirm__help {
    max-width: 38rem;
    margin-top: 0.75rem;
    font-size: var(--fs-body);                                                                    /* 14 -> 16 */
    line-height: 1.5;
  }
  .confirm__box {
    width: 100%;
    margin-top: 1.75rem;
    padding: 1.25rem 1.4rem;
    border-radius: var(--r-7);
    background: rgba(15, 21, 36, 0.05);
    text-align: left;
    font-size: var(--fs-body);
    line-height: 1.5;
  }
  .confirm__box p { margin-top: 0.6rem; }
  .confirm__h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-18);
    line-height: 1.3;
    font-weight: var(--fw-semibold);
    color: var(--c-navy);
  }
  .confirm__h3 :global(svg) { flex: none; color: var(--c-burgundy); }
  .confirm__h3--c { justify-content: center; margin-top: 2rem; font-family: var(--ff-serif); font-weight: var(--fw-medium); font-size: clamp(1.375rem, calc(1.375rem + 4 * (100vw - 24.375rem) / 1050), 1.625rem); }
  .confirm__help { margin-top: 0.5rem; color: color-mix(in srgb, var(--c-navy) 80%, transparent); }
  .confirm__actions {
    display: grid;
    gap: 0.75rem;
    width: min(100%, 23.6875rem);                                                                 /* 379 */
    margin-top: 1.25rem;
  }
  .confirm__line {
    display: grid;
    gap: 0.3rem;
    padding: 0.95rem 1rem;
    border-radius: var(--r-7);
    background: var(--c-burgundy);
    color: var(--c-cream);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease);
  }
  .confirm__line:hover { background: var(--c-burgundy-hover); }
  .confirm__line span { font-size: 0.75rem; letter-spacing: 0.04em; text-transform: uppercase; opacity: 0.85; }
  .confirm__line strong { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; font-size: 1.25rem; }
  .confirm :global(.confirm__btn) { display: flex; width: 100%; }
  .confirm__note { max-width: 34rem; margin-top: 1.25rem; font-size: var(--fs-13); line-height: 1.45; color: color-mix(in srgb, var(--c-navy) 70%, transparent); }
</style>
