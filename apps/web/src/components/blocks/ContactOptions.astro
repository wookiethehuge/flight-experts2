---
/**
 * "Contact us" option cards (Phone or callback / Email / WhatsApp). Used on the home page and the contact page.
 * Values: Contact (1440, HTML cards) and Mobile / ContactMobile (390). The heading is optional and, per the designs,
 * only shown from tablet up (it stays in the accessibility tree on mobile as a visually hidden heading).
 * Card body is Inline text: links inside it are underlined; the burgundy link at the bottom is the card action.
 */
import type { ContactOptionsBlock, SiteSettings } from '../../lib/types';
import { inline } from '../../lib/inline';
import Icon from '../ui/Icon.astro';
import Img from '../ui/Img.astro';

interface Props { block: ContactOptionsBlock; settings: SiteSettings; page: string; index: number }
const { block, index, page } = Astro.props;
// ContactMobile draws the WhatsApp card icon as an outline glyph (raster in Figma); Contact (desktop) and Mobile (home)
// use the filled icon.
const waOutline = page === 'contact';
const waOutlineMedia = { url: '/seed/whatsapp-outline.webp', alt: '' };
const cards = block.cards ?? [];
const hid = `contact-options-h-${index}`;
const TitleTag = block.heading ? 'h3' : 'h2';
const ext = (url: string) => /^https?:/i.test(url);
---
<section class="co on-light" aria-labelledby={block.heading ? hid : undefined} aria-label={block.heading ? undefined : 'Contact options'}>
  <div class="container">
    {block.heading && <h2 class="co__h" id={hid} set:html={inline(block.heading)} />}
    <ul class="co__grid" role="list">
      {cards.map((c, i) => (
        <li class="co__card lift" data-reveal style={`--i: ${i}`}>
          <span class:list={['co__icon', `co__icon--${c.icon}`]}>
            <Icon name={c.icon} class={c.icon === 'whatsapp' && waOutline ? 'co__wa-filled' : undefined} />
            {c.icon === 'whatsapp' && waOutline && <Img media={waOutlineMedia} decorative sizes="40px" widths={[40, 80, 120]} class="co__wa-outline" />}
          </span>
          <TitleTag class="co__title" id={`co-${index}-${i}`}>{c.title}</TitleTag>
          <p class="co__body" set:html={inline(c.body)} />
          <a class="co__link" href={c.linkUrl} aria-describedby={`co-${index}-${i}`} {...(ext(c.linkUrl) ? { target: '_blank', rel: 'noopener' } : {})}>
            {c.linkLabel}<Icon name="chevron-right-6" class="co__chev" />
            {ext(c.linkUrl) && <span class="sr-only"> (opens in a new tab)</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .co {
    --f: calc((100vw - 24.375rem) / 1050);
    /* 56 -> 103 top; bottom 5.5 -> 59.5 so the last card sits 84 (390) / 210 (1440) above the footer arc, as drawn
       (the footer adds its own 78 -> 150 above the arc) */
    padding-block: calc(clamp(3.5rem, calc(3.5rem + 47 * var(--f)), 6.4375rem) * var(--tighten)) clamp(0.34375rem, calc(0.34375rem + 54 * var(--f)), 3.71875rem);  /* bottom kept: the footer plane needs it */
  }
  .co__h {
    font-family: var(--ff-serif);
    font-weight: var(--fw-regular);
    font-size: var(--fs-h2);
    line-height: 1.2917;                                   /* 62 / 48 */
    color: var(--c-navy-ink);
    margin-bottom: 2.375rem;                               /* 38 */
  }
  .co__h :global(em) { font-style: italic; }
  .co__grid {
    display: grid;
    gap: clamp(0.8125rem, calc(0.8125rem + 5 * var(--f)), 1.125rem);   /* 13/15 -> 18 */
    margin: 0;
    padding: 0 2px;                                        /* mobile cards 346 wide at x 22 */
    list-style: none;
  }
  .co__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: clamp(15.5rem, calc(15.5rem + 45 * var(--f)), 18.3125rem);                 /* 248 -> 293 */
    padding: clamp(1.625rem, calc(1.625rem + 11 * var(--f)), 2.3125rem)                     /* 26 -> 37 */
             0.5rem
             clamp(1.6875rem, calc(1.6875rem + 16 * var(--f)), 2.6875rem)                    /* 27 -> 43 */
             clamp(2.25rem, calc(2.25rem + 1 * var(--f)), 2.3125rem);                        /* 36 -> 37 */
    border: 1px solid var(--c-border-soft);
    border-radius: var(--r-7);
    background: var(--c-white);
    box-shadow: var(--sh-card);
    color: var(--c-navy);
  }
  /* one icon box for every card (client: icons perfectly aligned): 48px, glyph centred, sizes balanced optically so
     the phone, envelope and WhatsApp marks carry the same weight and sit on the same centre line */
  .co__icon {
    --ib: clamp(2.5625rem, calc(2.5625rem + 7 * var(--f)), 3rem);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: var(--ib);
    height: var(--ib);
    color: var(--c-navy);
  }
  .co__icon :global(svg) { display: block; height: auto; }
  .co__icon--phone :global(svg) { width: 80%; }
  .co__icon--email :global(svg) { width: 88%; }
  .co__icon--whatsapp :global(svg) { width: 88%; }
  .co__icon :global(.co__wa-outline) { display: block; width: 2.5rem; height: auto; }             /* 40 x 39.66 */
  .co__icon :global(.co__wa-filled) { display: none; }
  @media (min-width: 48rem) {
    .co__icon :global(.co__wa-outline) { display: none; }
    .co__icon :global(.co__wa-filled) { display: block; }
  }
  .co__title {
    margin-top: clamp(1.375rem, calc(1.4375rem - 1 * var(--f)), 1.4375rem);                /* 23 -> 22 */
    font-family: var(--ff-sans);
    font-size: clamp(1rem, calc(1rem + 2 * var(--f)), 1.125rem);                           /* 16 -> 18 */
    line-height: clamp(1.3125rem, calc(1.3125rem + 3 * var(--f)), 1.5rem);                  /* 21 -> 24 */
    font-weight: var(--fw-semibold);
  }
  .co__body {
    margin-top: clamp(0.5625rem, calc(0.5625rem + 0.25 * var(--f)), 0.5781rem);            /* ~9 */
    max-width: clamp(17rem, calc(17rem + 80 * var(--f)), 22rem);                            /* 272 -> 352: wraps as drawn */
    font-size: clamp(0.875rem, calc(0.875rem + 2 * var(--f)), 1rem);                       /* 14 -> 16 */
    line-height: clamp(1.1875rem, calc(1.1875rem + 3 * var(--f)), 1.375rem);                /* 19 -> 22 */
    margin-bottom: 1.375rem;                                                                /* >= 22 above the link */
  }
  .co__body :global(a) { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .co__body :global(a[href^='tel:']) { white-space: nowrap; }
  .co__body :global(a:hover) { color: var(--c-burgundy); }
  .co__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: clamp(0.5625rem, calc(0.5625rem + 2 * var(--f)), 0.6875rem);                     /* 9 -> 11 */
    margin-top: auto;
    font-size: clamp(1rem, calc(1rem + 2 * var(--f)), 1.125rem);                           /* 16 -> 18 */
    line-height: clamp(1.3125rem, calc(1.3125rem + 3 * var(--f)), 1.5rem);                  /* 21 -> 24 */
    font-weight: var(--fw-medium);
    color: var(--c-burgundy);
    text-decoration: none;
  }
  .co__link::after { content: ''; position: absolute; inset: -0.625rem -0.5rem; }        /* 44px touch target */
  .co__link :global(.co__chev) { width: 6px; height: 10px; flex-shrink: 0; transition: transform var(--dur) var(--ease); }
  .co__link:hover { color: var(--c-burgundy-hover); text-decoration: underline; text-underline-offset: 3px; }
  .co__link:hover :global(.co__chev) { transform: translateX(3px); }

  @media (max-width: 47.99rem) {
    .co__h { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  @media (min-width: 64rem) {
    .co__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 0; }
    .co__card { padding-right: 1.5rem; }
  }
</style>
