---
/**
 * Burgundy benefits band under the hero: icon + bold title + text (Main 841-1039), 2x2 icon + title grid on mobile
 * (Mobile 885-1161). The mobile design shows titles only: the text stays in the DOM as visually hidden copy so
 * screen reader users get the same content.
 * Title/text flow as one paragraph (desktop "Optimize Your Time / & Budget. One expert ..."): a title ending in "."
 * runs straight into its text; otherwise the text starts on a new line. A newline in a title is a mobile line break
 * (a space from tablet up), and "& " keeps with the next word.
 */
import type { BenefitsBlock, SiteSettings } from '../../lib/types';
import { inline } from '../../lib/inline';
import Img from '../ui/Img.astro';

interface Props { block: BenefitsBlock; settings: SiteSettings; page: string; index: number }
const { block } = Astro.props;
const items = block.items ?? [];

const titleHtml = (t: string) => {
  const trimmed = t.trim();
  const sentence = /\.$/.test(trimmed);
  // newline -> mobile-only break; keep "&" with the following word
  const html = inline(sentence ? trimmed.slice(0, -1) : trimmed)
    .replace(/<br>/g, '<br class="ben__mbr"> ')
    .replace(/&amp; /g, '&amp;&nbsp;');
  return { html: html + (sentence ? '<span class="ben__dot">.</span>' : ''), sentence };
};
---
<section class="ben" aria-label="Why book with Flight Experts">
  <ul class="ben__list" role="list">
    {items.map((it, i) => {
      const t = titleHtml(it.title);
      return (
        <li class="ben__item" data-reveal style={`--i: ${i}`}>
          <span class="ben__icon"><Img media={it.icon} decorative sizes="51px" /></span>
          <p class="ben__txt">
            <strong class="ben__t" set:html={t.html} />{t.sentence ? ' ' : <br class="ben__br" />}<span class="ben__x">{!t.sentence && <span class="ben__sp"> </span>}{it.text}</span>
          </p>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .ben {
    --f: calc((100vw - 24.375rem) / 1050);
    background: var(--c-burgundy);
    color: var(--c-cream);
    padding: 1.5625rem var(--gutter) 2.25rem;              /* mobile 25 / 36 */
  }
  .ben__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 10rem));    /* 160 text boxes */
    justify-content: center;
    row-gap: 2.375rem;                                      /* 38 */
    max-width: 21.875rem;
    margin: 0 auto;
    padding: 0 0.4375rem 0 0;                               /* columns centred at x 112 / 272 as drawn */
    list-style: none;
  }
  .ben__item { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .ben__icon { display: flex; align-items: center; justify-content: center; height: 2.75rem; }   /* 44 */
  .ben__icon :global(img) { display: block; width: auto; height: auto; max-height: 100%; }
  .ben__txt {
    margin-top: 1.0625rem;                                  /* 17 */
    font-size: var(--fs-14);
    line-height: 1.125rem;                                  /* 18 */
  }
  .ben__t { font-weight: var(--fw-semibold); }
  /* mobile: titles only; text stays available to assistive tech */
  .ben__br { display: none; }
  .ben__x { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ben__t :global(.ben__dot) { display: none; }
  .ben__sp { white-space: pre; }

  @media (min-width: 48rem) {
    .ben { padding: 1.3125rem var(--gutter) 2rem; }         /* desktop 21 / 32 */
    .ben__list {
      grid-template-columns: 215fr 66fr 198fr 100fr 196fr 117fr 172fr;   /* Main: x 188..1252 */
      max-width: 66.5rem;                                   /* 1064 */
      padding: 0;
      column-gap: 0;
    }
    .ben__item:nth-child(1) { grid-column: 1; }
    .ben__item:nth-child(2) { grid-column: 3; }
    .ben__item:nth-child(3) { grid-column: 5; }
    .ben__item:nth-child(4) { grid-column: 7; }
    .ben__icon { width: 4.875rem; height: 4.875rem; }       /* 78 box */
    .ben__txt { margin-top: 0.375rem; font-size: var(--fs-16); line-height: 1.2625rem; }   /* 6, 16/20.2 */
    .ben__t :global(.ben__mbr) { display: none; }
    .ben__br { display: inline; }
    .ben__x { position: static; width: auto; height: auto; margin: 0; overflow: visible; clip: auto; white-space: normal; }
    .ben__sp { display: none; }
    .ben__t :global(.ben__dot) { display: inline; }
  }
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .ben__list { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 1.5rem; }
    .ben__item:nth-child(n) { grid-column: auto; }
  }
</style>
