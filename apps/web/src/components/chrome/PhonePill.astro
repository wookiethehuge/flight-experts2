---
/**
 * "24/7 PHONE DEALS / (888) 855-2389" pill (Figma: 223 x 52, radius 26, 1px #c7e8ff).
 *   outline: transparent with a sky border and cream text (dark header, menu panel)
 *   filled : sky fill with navy text (light header)
 * A tel: link; the chevron is decorative.
 */
import Icon from '../ui/Icon.astro';

interface Props {
  phone: { display: string; href: string };
  label: string;                       // settings.headerPhoneLabel
  variant?: 'outline' | 'filled';
  class?: string;
}
const { phone, label, variant = 'outline', class: cls } = Astro.props;
const spoken = `${label.charAt(0)}${label.slice(1).toLowerCase()}, ${phone.display}`;
---
<a class:list={['pill', `pill--${variant}`, cls]} href={phone.href} aria-label={spoken}>
  <span class="pill__text">
    <span class="pill__label">{label}</span>
    <span class="pill__num">{phone.display}</span>
  </span>
  <Icon name="chevron-down" width={11} height={6.793} class="pill__chev" />
</a>

<style>
  .pill {
    flex: none;
    display: flex;
    align-items: flex-start;
    width: 13.9375rem;               /* 223 */
    height: 3.25rem;                 /* 52 */
    padding: 11px 26.5px 0 29px;
    border: 1px solid var(--c-sky);
    border-radius: 26px;
    text-decoration: none;
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .pill__text { display: flex; flex-direction: column; align-items: center; width: 7.25rem; margin-top: -1px; }
  .pill__label { font-size: var(--fs-12); font-weight: var(--fw-light); line-height: 12px; white-space: nowrap; }
  .pill__num { margin-top: 1.5px; font-size: var(--fs-16); font-weight: var(--fw-medium); line-height: 16px; white-space: nowrap; }
  .pill :global(.pill__chev) { flex: none; align-self: center; margin: -1px 0 0 auto; color: var(--c-sky); }

  .pill--outline { color: var(--c-cream); background: transparent; }
  .pill--outline:hover { background: var(--c-sky-8); }
  .pill--filled { color: var(--c-navy); background: var(--c-sky); }
  .pill--filled :global(.pill__chev) { color: var(--c-navy); }
  .pill--filled:hover { box-shadow: inset 0 0 0 1px var(--c-navy); }
  .pill--filled:focus-visible { outline-color: var(--c-navy); }
</style>
