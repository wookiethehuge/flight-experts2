---
/**
 * Floating actions.
 *   < 64rem : 51px burgundy circles at the right edge in the upper middle of the viewport (BlogArticleMobile: x 331,
 *             y 374 / 434 in a 390x844 viewport = right 8px, top 44.3% / +60px). Plane opens the booking modal
 *             (open-booking event); chat opens the live chat (ChatWidget: Jivo when configured, otherwise a small
 *             built-in panel with WhatsApp, call and the quote form).
 *             Home page: the circles (and the desktop badge) stay hidden until the hero has mostly scrolled away
 *             (its bottom edge above 60% of the viewport height), then fade in; they hide again when scrolling back
 *             up into the hero. Other pages show them from load.
 *             The home page's light-blue phone tab (icon + number, 44px tall) slides in from the right edge once the
 *             hero form (#hero-form) has scrolled out of view; it sits low on the screen, clear of the circles.
 *   >= 64rem: the round "Get Flight Options" badge (117px) is docked in the bottom-right corner, follows the page all the way down and opens the booking
 *             modal. On the home page it comes in as the hero leaves (client request).
 * `plane` also controls the desktop badge (pass plane: false to hide both, e.g. on the thank-you page).
 * The desktop badge steps aside only over on-page forms.
 */
import Icon from '../ui/Icon.astro';
import FlightOptionsBadge from './FlightOptionsBadge.astro';
import ChatWidget from './ChatWidget.astro';
import type { SiteSettings } from '../../lib/types';

interface Props { settings: SiteSettings; plane?: boolean; chat?: boolean; phoneTab?: boolean }
const { settings, plane = true, chat = true, phoneTab = false } = Astro.props;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const showBadge = plane;
---
{(plane || chat || phoneTab || showBadge) && (
  <aside class="sticky" data-sticky aria-label="Quick actions">
    {phoneTab && (
      <a class="sticky__tab" href={settings.phone.href} aria-label={`Call ${settings.phone.display}`} data-phone-tab>
        <Icon name="phone" width={16} height={16} />
        <span class="sticky__tabnum">{settings.phone.display}</span>
      </a>
    )}
    {(plane || chat) && (
      <div class:list={['sticky__circles', !plane && 'sticky__circles--chat-only']} data-circles data-await-anchor={isHome ? '' : undefined}>
        {plane && (
          <button type="button" class="sticky__btn" data-open-booking aria-haspopup="dialog" aria-label="Get flight options">
            <Icon name="plane-up" width={26.4} height={25.2} />
          </button>
        )}
        {chat && <ChatWidget settings={settings} />}
      </div>
    )}
    {showBadge && <div class="sticky__badgewrap" data-await-anchor={isHome ? '' : undefined}><FlightOptionsBadge class="sticky__badge" /></div>}
  </aside>
)}

<style>
  .sticky {
    --edge-r: max(0.5rem, env(safe-area-inset-right));            /* x 331 + 51 = 382 in a 390 frame: 8px from the edge */
    --circles-top: 44.3%;                                           /* y 374 of 844 */
  }

  .sticky__circles {
    position: fixed;
    z-index: 40;
    top: var(--circles-top);
    right: var(--edge-r);
    display: grid;
    gap: 9px;                                                       /* 434 - 374 - 51 */
    pointer-events: none;                                           /* only the buttons take clicks */
    transform-origin: 100% 0;
  }
  .sticky__circles > :global(*) { pointer-events: auto; }
  .sticky__circles--chat-only { padding-top: 60px; }                /* chat keeps its own slot (y 434) */
  .sticky__btn, .sticky__circles :global(.sticky__btn) {
    display: grid;
    place-items: center;
    width: 51px;
    height: 51px;
    padding: 0;
    border: 1px solid var(--c-sky);
    border-radius: 50%;
    background: var(--c-burgundy);
    box-shadow: var(--sh-float);
    color: var(--c-sky);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease);
  }
  .sticky__btn:hover { background: var(--c-burgundy-hover); }

  /* home: hidden until the hero has scrolled away, then fade in */
  :global(html.js) [data-await-anchor] {
    opacity: 0;
    visibility: hidden;
    transform: scale(0.85);
    transition: opacity 500ms var(--motion-ease-out), transform 500ms var(--motion-ease-out), visibility 0s linear 500ms;
  }
  :global(html.js) [data-await-anchor][data-shown] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 500ms var(--motion-ease-out), transform 500ms var(--motion-ease-out), visibility 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .sticky__circles[data-await-anchor], :global(html.js) [data-await-anchor][data-shown] { transform: none; transition: none; }
  }

  /* phone tab (client: it was too small, a clipped 37px stub): a full 44px-tall pill against the right edge with the
     phone icon and the number, sliding in from the edge. Low on the screen, clear of the circles above. */
  .sticky__tab {
    position: fixed;
    z-index: 40;
    right: 0;
    bottom: max(calc(0.75rem + env(safe-area-inset-bottom)), min(calc(140px + env(safe-area-inset-bottom)), calc(55.7vh - 160px)));
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 44px;
    padding: 0 calc(1rem + env(safe-area-inset-right)) 0 1rem;
    border-radius: 22px 0 0 22px;
    background: var(--c-sky);
    box-shadow: var(--sh-tab);
    color: var(--c-navy);
    font-size: var(--fs-14);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    white-space: nowrap;
    translate: 105% 0;
    visibility: hidden;
    transition: translate 650ms var(--motion-ease-out), visibility 0s linear 650ms;
  }
  .sticky__tab[data-shown] { translate: none; visibility: visible; transition: translate 650ms var(--motion-ease-out), visibility 0s; }
  .sticky__tab:focus-visible { outline-color: var(--c-navy); }

  .sticky__badgewrap { display: none; }

  @media (min-width: 64rem) {
    .sticky__circles, .sticky__tab { display: none; }
    .sticky__badgewrap {
      display: block;
      position: fixed;
      z-index: 40;
      /* docked in the bottom-right corner the whole way down (client: it jumped when it moved for the footer) */
      bottom: calc(2rem + env(safe-area-inset-bottom));
      right: calc(max(0px, (100vw - var(--page-max)) / 2) + 2rem);
      transition: opacity var(--dur) var(--ease), visibility 0s linear 0s;
    }
    .sticky__badgewrap { transform-origin: 50% 50%; }
    /* step aside while an on-page form is on screen */
    .sticky[data-away] :global(.sticky__badge) { opacity: 0; visibility: hidden; transition: opacity var(--dur) var(--ease), visibility 0s linear var(--dur); }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-sticky]');
  if (root && 'IntersectionObserver' in window) {
    // phone tab: appear once the hero booking form is out of view
    const tab = root.querySelector<HTMLElement>('[data-phone-tab]');
    if (tab) {
      const hero = document.getElementById('hero-form');
      if (!hero) tab.setAttribute('data-shown', '');
      else new IntersectionObserver(([e]) => tab.toggleAttribute('data-shown', !e.isIntersecting && e.boundingClientRect.bottom < 0)).observe(hero);
    }
    // home: circles + badge appear once the hero has mostly scrolled away (its bottom above 60% of the viewport)
    const waiting = [...root.querySelectorAll<HTMLElement>('[data-await-anchor]')];
    const hero = document.querySelector<HTMLElement>('.hero');
    if (waiting.length) {
      if (!hero) waiting.forEach((el) => el.setAttribute('data-shown', ''));
      else {
        let was: boolean | undefined;
        const check = () => {
          const shown = hero.getBoundingClientRect().bottom < innerHeight * 0.6;
          if (shown === was) return;
          was = shown;
          waiting.forEach((el) => el.toggleAttribute('data-shown', shown));
          if (!shown) document.dispatchEvent(new CustomEvent('chat:close'));
        };
        let raf = 0;
        addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; check(); }); }, { passive: true });
        addEventListener('resize', check);
        check();
      }
    }
    // desktop badge steps aside while an on-page form is on screen, and below 1280px also while an element marked
    // [data-badge-avoid] is (the blog article's sticky sidebar CTA, which the badge would cover in the narrower column)
    const narrow = matchMedia('(max-width: 79.99rem)');
    const seen = new Set<Element>();
    const forms = new Set(document.querySelectorAll('main form'));
    const update = () => root.toggleAttribute('data-away', [...seen].some((el) => forms.has(el) || narrow.matches));
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? seen.add(e.target) : seen.delete(e.target);
      update();
    });
    // never cover an on-page form (contact form, hero quote form)
    forms.forEach((el) => io.observe(el));
    document.querySelectorAll('[data-badge-avoid]').forEach((el) => io.observe(el));
    narrow.addEventListener('change', update);
  } else {
    root?.querySelector('[data-phone-tab]')?.setAttribute('data-shown', '');
    root?.querySelectorAll('[data-await-anchor]').forEach((el) => el.setAttribute('data-shown', ''));
  }
</script>
