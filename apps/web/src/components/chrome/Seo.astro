---
import type { Seo } from '../../lib/types';
import { getImage } from 'astro:assets';
import { seedAsset } from '../../lib/cms';
import { NOINDEX } from '../../lib/env';

interface Props { title: string; description?: string; seo?: Seo; noindex?: boolean; type?: 'website' | 'article' }
const { title, description, seo = {}, noindex, type = 'website' } = Astro.props;
const fullTitle = seo.title || (title === 'Flight Experts' ? title : `${title} | Flight Experts`);
const desc = seo.description || description || 'Business and first class flights at insider rates. Share your route and a dedicated Flight Experts consultant sends curated options, then handles every detail.';
// the 404 page gets no canonical / og:url (it is served for any missing URL)
const is404 = /^\/404(\.html|\/)?$/.test(Astro.url.pathname);
const canonical = is404 ? undefined : seo.canonical || new URL(Astro.url.pathname.replace(/\/?$/, '/').replace(/^\/\/$/, '/'), Astro.site).href;
let ogImage = seo.image?.url;
if (ogImage) {
  const local = seedAsset(ogImage);
  if (local && typeof local === 'object') ogImage = (await getImage({ src: local, width: 1200, format: 'jpeg' })).src;
  ogImage = new URL(ogImage, Astro.site).href;
} else {
  const hero = seedAsset('/seed/hero-desktop.webp');
  ogImage = hero && typeof hero === 'object' ? new URL((await getImage({ src: hero, width: 1200, format: 'jpeg' })).src, Astro.site).href : undefined;
}
---
<title>{fullTitle}</title>
<meta name="description" content={desc} />
{canonical && <link rel="canonical" href={canonical} />}
{(noindex || seo.noindex || NOINDEX) && <meta name="robots" content="noindex, follow" />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Flight Experts" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
{canonical && <meta property="og:url" content={canonical} />}
{ogImage && <meta property="og:image" content={ogImage} />}
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
