---
/** Blog index pages 2..n (page 1 is /blog/). */
import type { GetStaticPaths } from 'astro';
import BlogListing from '../../../components/blog/BlogListing.astro';
import { getPosts } from '../../../lib/cms';
import { pageCount } from '../../../lib/blog';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return Array.from({ length: pageCount(posts) - 1 }, (_, i) => ({ params: { page: String(i + 2) }, props: { posts, page: i + 2 } }));
}) satisfies GetStaticPaths;

const { posts, page } = Astro.props;
---
<BlogListing posts={posts} page={page} />
